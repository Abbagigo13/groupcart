# Pi Network integration
# Keep PI_API_KEY server-side. Never expose it as VITE_PI_API_KEY.
PI_API_KEY=replace-with-the-server-api-key-from-the-pi-developer-portal
# Use true for Testnet/Sandbox and false for Mainnet production.
PI_SANDBOX=true
# Optional override; official default is the Pi Platform API.
PI_API_BASE=https://api.minepi.com/v2
# Browser-safe build flag. Default is Testnet in dev and Mainnet in production.
VITE_PI_SANDBOX=true
